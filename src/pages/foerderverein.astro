---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import Icon from '../components/Icon.astro';
import { kontakt } from '../data/site.js';

const punkte = [
  'Anschaffung zusätzlicher Ausrüstung und Technik',
  'Unterstützung der Jugend- und Kinderfeuerwehr',
  'Aus- und Fortbildung der Mitglieder',
  'Gemeinschaft, Veranstaltungen und Kameradschaftspflege',
];
---
<Base title="Förderverein" description="Der Förderverein der Freiwilligen Feuerwehr Bendestorf – unterstütze die Wehr, auch ohne aktiven Dienst.">
  <PageHero
    eyebrow="Unterstützen"
    title="Förderverein der Feuerwehr."
    text="Nicht jede und jeder kann aktiven Dienst leisten – unterstützen kann aber jede und jeder. Als förderndes Mitglied stärkst du unsere Arbeit direkt."
  />

  <section class="section" style="padding-top: 0">
    <div class="container split">
      <div data-reveal="0">
        <h2 class="split__title">Wofür dein Beitrag wirkt</h2>
        <ul class="checklist">
          {punkte.map((p) => (
            <li><span class="check"><Icon name="check" size={16} /></span>{p}</li>
          ))}
        </ul>
        <p class="muted-note">Beitragshöhe, Satzung und Beitrittsformular werden ergänzt, sobald die Inhalte vorliegen.</p>
        <a href="/kontakt" class="btn btn--primary">Fördermitglied werden <Icon name="arrow" size={18} /></a>
      </div>
      <div data-reveal="120">
        <PhotoPlaceholder label="FOTO · FÖRDERVEREIN" ratio="4 / 3" />
      </div>
    </div>
  </section>
</Base>

<style>
  .split { display: grid; grid-template-columns: 1.1fr .9fr; gap: 44px; align-items: center; }
  .split__title { font-weight: 800; font-size: clamp(26px, 3vw, 40px); margin-bottom: 20px; }
  .checklist { list-style: none; margin: 0 0 20px; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .checklist li { display: flex; align-items: flex-start; gap: 12px; color: var(--ink-soft); }
  .check { flex: none; width: 26px; height: 26px; border-radius: 8px; background: var(--tint); color: var(--red); display: flex; align-items: center; justify-content: center; margin-top: 2px; }
  .muted-note { font-size: 14px; color: var(--muted); font-style: italic; margin-bottom: 22px; }
  @media (max-width: 820px) { .split { grid-template-columns: 1fr; gap: 24px; } }
</style>
