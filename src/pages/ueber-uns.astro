---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import Icon from '../components/Icon.astro';
import { kennzahlen } from '../data/site.js';

const aufgaben = [
  { t: 'Retten', d: 'Menschen und Tiere aus Gefahrenlagen befreien.' },
  { t: 'Löschen', d: 'Brände bekämpfen und ihre Ausbreitung verhindern.' },
  { t: 'Bergen', d: 'Sachwerte sichern und nach Schadenslagen bergen.' },
  { t: 'Schützen', d: 'Gefahren von Mensch und Umwelt fernhalten.' },
];
---
<Base title="Über uns" description="Die Freiwillige Feuerwehr Bendestorf – Geschichte, Kommando und unsere vier Grundaufgaben.">
  <PageHero
    eyebrow="Über uns"
    title="Ehrenamt mit Verantwortung."
    text="Wir sind eine Freiwillige Feuerwehr – getragen von Menschen aus Bendestorf, die in ihrer Freizeit für die Sicherheit aller einstehen."
  />

  <!-- Aufgaben -->
  <section class="section" style="padding-top: 0">
    <div class="container">
      <div class="grid grid-4">
        {aufgaben.map((a, i) => (
          <div class="card aufgabe" data-reveal={i * 80}>
            <span class="aufgabe__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="aufgabe__t">{a.t}</h3>
            <p class="aufgabe__d">{a.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Geschichte -->
  <section class="section section--alt">
    <div class="container split">
      <div data-reveal="0">
        <span class="eyebrow">Unsere Geschichte</span>
        <h2 class="split__title">Seit Generationen für Bendestorf da.</h2>
        <p>
          Die Freiwillige Feuerwehr Bendestorf ist fest in der Gemeinde verwurzelt. Über die Jahrzehnte
          ist aus engagierten Bürgerinnen und Bürgern eine schlagkräftige Stützpunktfeuerwehr geworden.
        </p>
        <p class="muted-note">Der ausführliche Geschichtstext wird von der bisherigen Website übernommen, sobald die Inhalte vorliegen.</p>
      </div>
      <div data-reveal="120">
        <PhotoPlaceholder label="FOTO · GERÄTEHAUS" ratio="4 / 3" />
      </div>
    </div>
  </section>

  <!-- Kennzahlen -->
  <section class="dark stats">
    <div class="container grid grid-4">
      {kennzahlen.map((k, i) => (
        <div class="stat text-center" data-reveal={i * 80}>
          {k.wert !== null
            ? <div class="stat__num" data-count data-target={k.wert}>0</div>
            : <div class="stat__num accent-ember">{k.anzeige}</div>}
          <div class="stat__label">{k.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Kommando -->
  <section class="section">
    <div class="container">
      <div class="head-row" data-reveal="0">
        <div>
          <span class="eyebrow">Kommando</span>
          <h2 class="head-row__title">Die Führung der Wehr</h2>
        </div>
      </div>
      <div class="note" data-reveal="0"><Icon name="users" size={18} /><p>Die Namen und Funktionen von Ortsbrandmeister, Stellvertretung und weiteren Funktionsträgern werden ergänzt, sobald die Inhalte vorliegen.</p></div>
      <div class="grid grid-3">
        {[0,1,2].map((i) => (
          <div class="person" data-reveal={i * 80}>
            <PhotoPlaceholder label="FOTO" ratio="1 / 1" />
            <h3 class="person__name">Name folgt</h3>
            <p class="person__role">Funktion folgt</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .aufgabe { position: relative; }
  .aufgabe__num { font-family: var(--font-display); font-weight: 900; font-size: 14px; color: var(--red); letter-spacing: .08em; }
  .aufgabe__t { font-weight: 800; font-size: 22px; margin: 8px 0 6px; }
  .aufgabe__d { color: var(--muted); font-size: 15px; margin: 0; }

  .section--alt { background: var(--cream); }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; align-items: center; }
  .split__title { font-weight: 800; font-size: clamp(26px, 3vw, 40px); margin-bottom: 16px; }
  .split p { color: var(--ink-soft); }
  .muted-note { font-size: 14px; color: var(--muted); font-style: italic; }

  .stats { padding-block: 48px; }
  .stat__num { font-family: var(--font-display); font-weight: 900; font-size: clamp(40px, 5vw, 54px); line-height: 1; color: #fff; }
  .accent-ember { color: var(--ember); }
  .stat__label { color: var(--on-dark-muted); font-size: 14px; margin-top: 8px; letter-spacing: .04em; }

  .head-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .head-row__title { font-weight: 800; font-size: clamp(30px, 3.6vw, 46px); margin: 0; }

  .note { display: flex; align-items: center; gap: 12px; background: var(--tint); color: var(--red-dark); border-radius: 12px; padding: 14px 18px; margin-bottom: 28px; font-size: 14px; }
  .note p { margin: 0; }

  .person { text-align: center; }
  .person :global(.photo) { border-radius: var(--radius); margin-bottom: 14px; }
  .person__name { font-weight: 800; font-size: 18px; margin: 0 0 2px; }
  .person__role { color: var(--muted); font-size: 14px; margin: 0; }

  @media (max-width: 820px) { .split { grid-template-columns: 1fr; gap: 24px; } }
</style>
